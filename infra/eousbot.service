[Unit]
Description=EousBot - self-modifying Discord bot
# A Discord bot only makes outbound connections, so network-online is enough;
# there is nothing to bind and nothing to wait for inbound.
After=network-online.target
Wants=network-online.target

# A crash loop from bad generated code must not become an infinite restart
# loop. Five failures inside a minute stops the unit and leaves it stopped for
# a human, so the failure is visible instead of silently churning.
#
# These MUST live in [Unit], not [Service]. systemd silently ignores them in
# [Service] -- no warning, no error, the unit just restarts forever. Verified
# the hard way: a bad token produced a restart counter of 17 with these in the
# wrong section.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/EousBot
EnvironmentFile=%h/EousBot/.env
ExecStart=/usr/bin/node %h/EousBot/dist/index.js

# systemd user units do not source profile.d, so ~/.local/bin is absent from
# the default PATH; this gives the agents' shells the PATH an SSH login has.
# The agents themselves do not come from here. The Agent SDK runs the CLI
# bundled in node_modules/@anthropic-ai/claude-agent-sdk-<platform>/, whose
# version follows the SDK's, not whatever ~/.local/bin/claude updated to.
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

# An agent's shell can run anything, so one command can eat the host. On
# 2026-09-22 a chat's `grep` (the CLI runs grep as its embedded ugrep) grew to
# 5.9GB, and the host thrashed for 22 minutes before the kernel killed it. The
# ceiling keeps a runaway inside this unit, where it is killed within seconds.
MemoryMax=3G
# The default, OOMPolicy=stop, answers the kernel killing any process in the
# unit by stopping the whole unit: the grep died, then the bot, and the
# question it was answering never got a reply. With `continue` only the
# runaway dies, and the agent sees a failed command and carries on.
OOMPolicy=continue

# The bot restarts *itself* as part of normal operation: it exits cleanly after
# a successful self-deploy and relies on systemd to bring up the new build.
# Restart=always is therefore load-bearing, not just crash insurance.
Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eousbot

# Modest hardening. Deliberately NOT ProtectHome or ReadOnlyPaths: the whole
# point of this service is that it rewrites its own checkout under $HOME.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
