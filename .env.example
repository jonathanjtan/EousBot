# ---------------------------------------------------------------- Discord ---
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application ID from the same page (General Information -> Application ID)
DISCORD_APP_ID=
# Guild to register slash commands into. Guild commands appear instantly;
# global commands take up to an hour to propagate, which makes iterating painful.
DISCORD_GUILD_ID=
# Channel the bot posts build results and approval prompts to.
DISCORD_CHANNEL_ID=

# The ONLY users who may run /claude or click Approve. Comma-separated Discord
# user IDs (enable Developer Mode -> right-click a user -> Copy User ID).
# This is the entire security boundary on self-modification. An empty value
# means nobody can build, which is the correct failure mode.
DISCORD_ADMIN_IDS=

# ----------------------------------------------------------------- GitHub ---
# Fine-grained PAT scoped to THIS repo only, with:
#   Contents: Read and write   (push branches, merge)
#   Issues: Read and write     (feature requests)
#   Pull requests: Read and write
GITHUB_TOKEN=
GITHUB_OWNER=jonathanjtan
GITHUB_REPO=EousBot

# --------------------------------------------------------------- Anthropic ---
# OPTIONAL. Two modes:
#
#   Set it      -> metered Anthropic API spend, billed per token. Required if
#                  anyone other than you can trigger a build.
#   Leave blank -> the Agent SDK inherits whatever `claude` is logged in as on
#                  this machine. No relay needed; it resolves credentials the
#                  same way the CLI does.
#
# Blank is defensible when EousBot is your own automation and /claude stays
# admin-only, so only you can spend your own quota -- the same shape as running
# `claude` yourself on a remote box you own. It is NOT appropriate once other
# people can cause inference on your subscription. See README.md.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ Agent ---
# Model the codegen agent runs as. /claude's `model` option overrides this for
# one build; the option only offers models that accept an effort level.
AGENT_MODEL=claude-opus-5
# OPTIONAL. Standing reasoning effort: low, medium, high, xhigh, or max.
# /claude's `effort` option overrides it per build. Defaults to medium, which
# suits most feature requests; raise it per build when one warrants it.
#AGENT_EFFORT=medium
# Hard ceiling on agentic turns per build, so a confused agent can't burn
# unbounded tokens on one feature request.
AGENT_MAX_TURNS=60

# How much of each build session is reachable from the Claude app:
#   off    - nothing leaves the box
#   view   - mirrored to claude.ai read-only, so you can watch it in the app
#   remote - also opens the Remote Control bridge, so you can steer a run
# Both non-off modes upload the session transcript -- which includes this
# repository's code -- to claude.ai.
AGENT_SESSION_VISIBILITY=view

# ------------------------------------------------------------------- Chat ---
# Claude Code, reachable from Discord. @mention the bot, or right-click any
# message and pick Apps -> Ask EousBot. This agent has the real tool set --
# Bash, Read, Write -- running unattended at bypassPermissions, so it can
# actually do the job rather than explain how you would.
#
# ADMIN-ONLY, and that is the whole security model. It runs as the same Unix
# user as the bot, so the scratch workspace below is hygiene, not a boundary:
# anything this user can read is reachable by a sufficiently misled agent, and
# the agent reads screenshots, quoted messages and web pages that other people
# wrote. Do not widen this past DISCORD_ADMIN_IDS without moving it to its own
# user or a container first. CHAT_ENABLED=false turns it off entirely.
CHAT_ENABLED=true
CHAT_MODEL=claude-sonnet-5
# low, medium, high, xhigh, or max.
CHAT_EFFORT=medium
# Enough to fetch thirty files, write a script and run it.
CHAT_MAX_TURNS=30
# Scratch workspaces live here, one per conversation, never the live checkout.
# Blank uses a subdirectory of the system temp dir. Anything the agent leaves
# in its workspace is attached to the Discord reply.
CHAT_WORKSPACE_ROOT=
# How long a channel's session and workspace survive between messages, so a
# follow-up continues the conversation instead of starting over. Default 2h.
CHAT_CONVERSATION_TTL_MS=7200000
# Total bytes of agent-produced files attached to one reply. Discord's ceiling
# is 10MB on an unboosted guild.
CHAT_MAX_UPLOAD_BYTES=8000000
# Ceilings on a single conversation. Mentioning the bot resumes the channel's
# session, and resuming replays the whole transcript on every turn -- so a
# channel chatting all afternoon pays more per question than one that just
# started. CHAT_CONVERSATION_TTL_MS above only fires after silence, which a
# busy channel never has, so these are what actually bound it. The session
# rolls over at whichever comes first; the workspace and its files survive.
# `/chat status` shows where a channel is, `/chat reset` clears it by hand.
CHAT_SESSION_MAX_TURNS=20
CHAT_SESSION_MAX_AGE_MS=3600000

# ---------------------------------------------------------------- Runtime ---
# REPO_PATH is derived from the running code's own location and should be left
# unset. It exists only as an escape hatch for the unusual case where the
# checkout to deploy is not the one this code was loaded from. Setting it means
# the file stops being portable between machines.
#REPO_PATH=
# systemd unit to restart after a successful self-deploy. Leave empty to
# disable the restart step (useful when running locally).
SYSTEMD_UNIT=eousbot.service
LOG_LEVEL=info

# Privileged gateway intents, comma-separated: members, presence, messagecontent.
# Blank asks for none, which is the historical behaviour and the safer default.
#
# Each must ALSO be enabled in the Discord Developer Portal (Bot -> Privileged
# Gateway Intents). Requesting one the portal has not granted makes the gateway
# refuse the connection outright -- and a bot that cannot log in is one systemd
# restarts five times and then gives up on. Flip the portal switches FIRST.
#
# What each buys Idle RPG:
#   messagecontent - a message's length, so talking is billed the way the
#                    original bills an IRC line rather than at a flat rate.
#                    Also means this process can read ordinary conversation.
#   presence       - who is actually connected, so nobody ever types /login.
#   members        - leaving the server and renaming yourself.
#DISCORD_PRIVILEGED_INTENTS=members,presence,messagecontent

# --------------------------------------------------------------- /idlerpg ---
# Idle RPG (idlerpg.net) on Discord: you level up by staying logged in and
# saying nothing. Off by default -- it ticks forever and narrates itself into a
# channel, which is not a thing to switch on for a server by surprise.
IDLERPG_ENABLED=false

# Where the realm narrates itself. Blank uses DISCORD_CHANNEL_ID. Give it its
# own channel unless you want level-ups in with everything else.
#IDLERPG_CHANNEL_ID=

# Which messages break idle. `channel` (the default) charges only for talking in
# the game channel, which is the closer analogue: on IRC you joined #idlerpg to
# idle in it, and talking in the other channels you sat in cost nothing. `guild`
# charges for talking anywhere, which makes playing a vow of silence across the
# whole server.
#IDLERPG_PENALTY_SCOPE=channel

# What decides whether a clock is running.
#   manual   - only /idlerpg login and /idlerpg logout (default; no intent needed)
#   presence - follows Discord status, so nobody ever types /login
# `presence` needs `presence` in DISCORD_PRIVILEGED_INTENTS and falls back to
# manual with a loud log line if the intent is missing.
#IDLERPG_ONLINE_SOURCE=manual

# The level curve. 600 and 1.16 are jotun's, unchanged since 2004, and describe
# a game measured in years: about ten minutes to level 1 and a month to level
# 45. rpstep is the base of an exponential, so nudging it does not speed the
# game up a little -- it makes a different game. Raise IDLERPG_RPSTEP only if
# you have decided you want one.
#IDLERPG_RPBASE=600
#IDLERPG_RPSTEP=1.16

# How steeply penalties grow with level, and an optional ceiling on any single
# one in seconds (0 = uncapped, as upstream).
#IDLERPG_PENSTEP=1.14
#IDLERPG_PENLIMIT=0

# How often the world advances, and the most real time one tick may credit.
# The catch-up cap is what stops a self-deploy from costing anyone their idling
# while stopping a long outage from gifting it: longer than any deploy, shorter
# than any outage worth noticing.
#IDLERPG_TICK_MS=10000
#IDLERPG_MAX_CATCHUP_S=600

# Map edge length, save interval, and how long a player goes between being told
# what talking costs them.
#IDLERPG_MAP_SIZE=500
#IDLERPG_SAVE_INTERVAL_MS=60000
#IDLERPG_NOTICE_THROTTLE_MS=3600000

# --------------------------------------------------------------- /restock ---
# Relay community drop feeds into Discord and ping on keyword matches. The bot
# alerts; it never buys. See README.md.
#
# Off by default -- it is the only feature that talks to a third party on a
# timer. Note that it reads RSS rather than Target directly: Target's live stock
# API answers a bare HTTP client with a CAPTCHA challenge from any network, so
# there is no stock to poll for. `/restock check` shows you that firsthand.
TARGET_RESTOCK_ENABLED=false

# Feeds to relay, comma-separated as `name|url`. Blank uses the built-in
# default (r/pkmntcgdeals), which is where Target drops get called first.
#TARGET_FEED_URLS=r/pkmntcgdeals|https://www.reddit.com/r/pkmntcgdeals/new.rss
# Milliseconds between polls, minimum 60000. Reddit rate-limits unauthenticated
# readers hard, and the people writing these posts are the latency floor anyway.
TARGET_FEED_POLL_MS=120000

# Used by `/restock check`, which reads one listing's static facts. Pricing and
# pickup are per-store; the default below is a real store and will answer, but
# it will not be *your* prices -- get yours from the store picker on target.com.
TARGET_STORE_ID=1234
TARGET_ZIP=
TARGET_STATE=
