# ---------------------------------------------------------------- Discord ---
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application ID from the same page (General Information -> Application ID)
DISCORD_APP_ID=
# Guild to register slash commands into. Guild commands appear instantly;
# global commands take up to an hour to propagate, which makes iterating painful.
DISCORD_GUILD_ID=
# Channel the bot posts build results and approval prompts to.
DISCORD_CHANNEL_ID=

# The ONLY users who may run /build or click Approve. Comma-separated Discord
# user IDs (enable Developer Mode -> right-click a user -> Copy User ID).
# This is the entire security boundary on self-modification. An empty value
# means nobody can build, which is the correct failure mode.
DISCORD_ADMIN_IDS=

# ----------------------------------------------------------------- GitHub ---
# Fine-grained PAT scoped to THIS repo only, with:
#   Contents: Read and write   (push branches, merge)
#   Issues: Read and write     (feature requests)
#   Pull requests: Read and write
GITHUB_TOKEN=
GITHUB_OWNER=jonathanjtan
GITHUB_REPO=EousBot

# --------------------------------------------------------------- Anthropic ---
# OPTIONAL. Two modes:
#
#   Set it      -> metered Anthropic API spend, billed per token. Required if
#                  anyone other than you can trigger a build.
#   Leave blank -> the Agent SDK inherits whatever `claude` is logged in as on
#                  this machine. No relay needed; it resolves credentials the
#                  same way the CLI does.
#
# Blank is defensible when EousBot is your own automation and /build stays
# admin-only, so only you can spend your own quota -- the same shape as running
# `claude` yourself over Tailscale. It is NOT appropriate once other people can
# cause inference on your subscription. See README.md.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ Agent ---
# Model the codegen agent runs as.
AGENT_MODEL=claude-opus-5
# Hard ceiling on agentic turns per build, so a confused agent can't burn
# unbounded tokens on one feature request.
AGENT_MAX_TURNS=60

# ---------------------------------------------------------------- Runtime ---
# Absolute path to the checkout the bot runs from. Self-redeploy pulls here.
REPO_PATH=/home/azureuser/EousBot
# systemd unit to restart after a successful self-deploy. Leave empty to
# disable the restart step (useful when running locally).
SYSTEMD_UNIT=eousbot.service
LOG_LEVEL=info
